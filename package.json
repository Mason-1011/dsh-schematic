{
  "name": "dsh-schematic",
  "version": "0.3.3",
  "description": "Live plugin-topology viewer for DeepSeek Harness: the wiring diagram of every mounted plugin, its runtime activity, a composer-side star map — and a composition workbench that edits the wiring on the graph itself (previewed, validated, backed up, reversible).",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "topology",
    "dependency-graph",
    "plugin-visualizer",
    "schematic",
    "plugin-manager",
    "agent-harness"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/dsh-app-boot": ">=0.1.0-rc.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mason-1011/dsh-schematic.git"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CHANGELOG.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.3.2",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.19"
  }
}
